# Copy to .env to change the defaults of docker-compose.yml

# Host port where the API is published
DIET_PORT=8000

# Directory with the trained models (models/<lang>/diet_model.pt, ...)
DIET_MODELS_DIR=./models

# Languages to load, space separated (empty = every language found in models/)
DIET_LANGS=es
# Language used when a request has no "language" (empty = first one loaded)
DIET_DEFAULT_LANG=es
